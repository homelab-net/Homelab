# Technitium DNS Server Environment Configuration
# Copy this file to .env and update the values

# Admin password for web interface
# Access at http://192.168.8.82:5380
DNS_ADMIN_PASSWORD=changeme123

# Optional: Configure upstream DNS servers
# These are used as fallback/forwarders
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8
